### CartoAgent API 测试集合
### 可在 VS Code REST Client 插件中使用
### Base URL: http://127.0.0.1:8080/api

@baseUrl = http://127.0.0.1:8080/api

#############################################
# 1. 智能体对话 API
#############################################

### 1.1 创建会话
POST {{baseUrl}}/chat/sessions
Content-Type: application/json

{
  "title": "测试会话",
  "map_type": "traffic",
  "region": "武汉市"
}

### 1.2 获取会话列表
GET {{baseUrl}}/chat/sessions?limit=10

### 1.3 发送消息（非流式）
# @session_id = sess_xxx
POST {{baseUrl}}/chat/sessions/{{session_id}}/messages
Content-Type: application/json

{
  "content": "生成武汉市交通图",
  "map_id": null
}

### 1.4 流式对话（SSE，需在支持 SSE 的客户端中测试）
# POST {{baseUrl}}/chat/sessions/{{session_id}}/stream
# Content-Type: application/json
#
# {
#   "content": "生成武汉市交通图",
#   "map_id": null
# }

### 1.5 获取评估结果
GET {{baseUrl}}/chat/evaluation?session_id={{session_id}}

#############################################
# 2. 地图管理 API
#############################################

### 2.1 生成地图
POST {{baseUrl}}/maps/generate
Content-Type: application/json

{
  "prompt": "生成武汉市交通图，道路完整，注记横向",
  "region": "武汉市",
  "map_type": "traffic"
}

### 2.2 获取地图列表
GET {{baseUrl}}/maps/?limit=20

### 2.3 获取地图详情
# @map_id = map_4a364bba42bb
GET {{baseUrl}}/maps/{{map_id}}

### 2.4 修改地图
POST {{baseUrl}}/maps/{{map_id}}/modify
Content-Type: application/json

{
  "prompt": "将所有注记改为横向排布，统一底色为浅灰色",
  "auto_apply": true
}

### 2.5 导出地图
POST {{baseUrl}}/maps/{{map_id}}/export
Content-Type: application/json

{
  "format": "geojson",
  "options": {"crs": "EPSG:4326"}
}

### 2.6 清理地图
POST {{baseUrl}}/maps/{{map_id}}/cleanup

### 2.7 地图质量
GET {{baseUrl}}/maps/{{map_id}}/quality

### 2.8 地图质检
GET {{baseUrl}}/maps/{{map_id}}/qa

### 2.9 专题图类型
GET {{baseUrl}}/maps/thematic/types

### 2.10 地图百科
GET {{baseUrl}}/maps/wiki

### 2.11 删除地图
# DELETE {{baseUrl}}/maps/{{map_id}}

#############################################
# 3. 图层管理 API
#############################################

### 3.1 添加图层
POST {{baseUrl}}/maps/{{map_id}}/layers
Content-Type: application/json

{
  "name": "测试图层",
  "type": "point",
  "style": {"color": "#FF0000", "radius": 5},
  "coordinates": [[30.59, 114.30]],
  "properties": [{"name": "测试点"}]
}

### 3.2 图层排序
POST {{baseUrl}}/maps/{{map_id}}/layers/reorder
Content-Type: application/json

{
  "order": ["layer_001", "layer_002", "layer_003"]
}

### 3.3 更新图层
# @layer_id = layer_xxx
PUT {{baseUrl}}/maps/{{map_id}}/layers/{{layer_id}}
Content-Type: application/json

{
  "name": "新图层名",
  "visible": true,
  "style": {"color": "#00FF00"}
}

### 3.4 部分更新图层
PATCH {{baseUrl}}/maps/{{map_id}}/layers/{{layer_id}}
Content-Type: application/json

{
  "visible": false
}

### 3.5 切换图层可见性
PUT {{baseUrl}}/maps/{{map_id}}/layers/{{layer_id}}/visible
Content-Type: application/json

{
  "visible": true
}

### 3.6 更新图层几何
PUT {{baseUrl}}/maps/{{map_id}}/layers/{{layer_id}}/geometry
Content-Type: application/json

{
  "coordinates": [[[30.5, 114.3], [30.6, 114.4]]],
  "feature_index": 0
}

### 3.7 复制图层
POST {{baseUrl}}/maps/{{map_id}}/layers/{{layer_id}}/duplicate

### 3.8 删除图层
# DELETE {{baseUrl}}/maps/{{map_id}}/layers/{{layer_id}}

#############################################
# 4. 样式与视图 API
#############################################

### 4.1 更新视图
PUT {{baseUrl}}/maps/{{map_id}}/view
Content-Type: application/json

{
  "center": [30.59, 114.30],
  "zoom": 12
}

### 4.2 更新主题
PUT {{baseUrl}}/maps/{{map_id}}/theme
Content-Type: application/json

{
  "theme": "light"
}

### 4.3 应用样式包
POST {{baseUrl}}/maps/{{map_id}}/style-package
Content-Type: application/json

{
  "styles": [
    {"layer_id": "layer_001", "style": {"color": "#FF0000", "weight": 4}}
  ]
}

#############################################
# 5. 知识图谱 API
#############################################

### 5.1 初始化图谱
POST {{baseUrl}}/knowledge/init

### 5.2 获取完整图谱
GET {{baseUrl}}/knowledge/graph

### 5.3 获取本体定义
GET {{baseUrl}}/knowledge/ontology

### 5.4 获取实体列表
GET {{baseUrl}}/knowledge/entities/MapType?limit=10

### 5.5 创建实体
POST {{baseUrl}}/knowledge/entities
Content-Type: application/json

{
  "label": "MapType",
  "name": "测试地图类型",
  "properties": {"description": "测试用"}
}

### 5.6 获取地图样式
GET {{baseUrl}}/knowledge/styles/traffic

### 5.7 符号推荐
POST {{baseUrl}}/knowledge/symbol-recommend
Content-Type: application/json

{
  "feature_type": "station",
  "map_type": "traffic",
  "scale": "1:100000"
}

### 5.8 RAG 检索
POST {{baseUrl}}/knowledge/rag-search
Content-Type: application/json

{
  "query": "交通图中道路如何分级配色",
  "top_k": 5
}

### 5.9 获取子图
GET {{baseUrl}}/knowledge/subgraph/交通图

### 5.10 获取制图质量标准
GET {{baseUrl}}/knowledge/cqs

### 5.11 获取约束
GET {{baseUrl}}/knowledge/constraints

#############################################
# 6. 系统设置 API
#############################################

### 6.1 获取全局设置
GET {{baseUrl}}/settings/

### 6.2 更新全局设置
PUT {{baseUrl}}/settings/
Content-Type: application/json

{
  "app": {"debug": true},
  "llm": {"temperature": 0.7}
}

### 6.3 获取 LLM 提供商列表
GET {{baseUrl}}/settings/llm/providers

### 6.4 设置当前 LLM 提供商
PUT {{baseUrl}}/settings/llm/provider
Content-Type: application/json

{
  "provider": "deepseek",
  "model": "deepseek-chat"
}

### 6.5 更新 API Key
PUT {{baseUrl}}/settings/llm/apikey
Content-Type: application/json

{
  "provider": "deepseek",
  "api_key": "sk-your-api-key"
}

### 6.6 获取可用模型列表
GET {{baseUrl}}/settings/llm/models?provider=deepseek

### 6.7 获取地图主题列表
GET {{baseUrl}}/settings/map/themes
