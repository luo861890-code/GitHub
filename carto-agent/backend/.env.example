# ========== LLM配置 ==========
# 默认LLM提供者: deepseek / ollama / qwen / openai / zhipu
# 注意：源码中不内置任何密钥，所有 API Key 均需在 .env 中配置。
LLM_PROVIDER=deepseek

# Ollama本地模型配置
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b

# 通义千问API配置
QWEN_API_KEY=
QWEN_MODEL=qwen-plus
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# OpenAI API配置
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# DeepSeek API配置（必填：默认 provider 需要 DEEPSEEK_API_KEY）
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# 智谱API配置
ZHIPU_API_KEY=
ZHIPU_MODEL=glm-4
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# ========== Neo4j知识图谱配置 ==========
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=neo4j123

# ========== 地图数据配置 ==========
# Overpass API服务器（多个用逗号分隔）
OVERPASS_SERVERS=https://maps.mail.ru/osm/tools/overpass/api/interpreter,https://overpass-api.de/api/interpreter,https://z.overpass-api.de/api/interpreter,https://lz4.overpass-api.de/api/interpreter

# 高德API配置（可选，多源数据融合适配器读取；AMAP_API_KEY 为兼容旧名）
AMAP_KEY=your_amap_key_here
AMAP_API_KEY=

# 天地图API Key（用于多源数据融合适配器的矢量底图服务；不配置则天地图不可用）
# 请到 https://console.tianditu.gov.cn 申请后填写，勿在源码中硬编码任何密钥
TIANDITU_KEY=

# ========== 服务配置 ==========
HOST=0.0.0.0
PORT=8080
DEBUG=false

# ========== 安全配置 ==========
# API 鉴权令牌（Bearer Token / X-API-Key）。生产部署务必设置；留空则不强制鉴权
API_TOKEN=
# 允许的跨域来源（逗号分隔），用于前端跨域访问后端；留空表示允许所有来源
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080

# 数据目录
DATA_DIR=../data
